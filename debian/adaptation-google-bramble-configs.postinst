#!/bin/sh
set -e

# Pin mesa-vulkan-drivers so system upgrades do not overwrite KGSL-enabled Turnip
apt-mark hold mesa-vulkan-drivers 2>/dev/null || true

# Ensure permissions on hardware nodes
chmod 666 /dev/ion /dev/kgsl-3d0 /dev/dri/card0 /dev/dri/renderD128 /dev/input/event* 2>/dev/null || true

# Mask android-composer to prevent DRM master contention
systemctl mask android-composer.service 2>/dev/null || true

# Disable libhybris EGL vendor so libglvnd defaults to native Mesa
if [ -f /usr/share/glvnd/egl_vendor.d/10_libhybris.json ]; then
    mv /usr/share/glvnd/egl_vendor.d/10_libhybris.json /usr/share/glvnd/egl_vendor.d/10_libhybris.json.disabled 2>/dev/null || true
fi

# Mask broken API33 selinux stubs dropin on android-mount
mkdir -p /etc/systemd/system/android-mount.service.d
ln -sf /dev/null /etc/systemd/system/android-mount.service.d/10-selinux.conf 2>/dev/null || true


# Fix timestamp for mobile-config-firefox fragments to prevent infinite restart loop before NTP sync
if [ -d /etc/mobile-config-firefox ]; then
    find /etc/mobile-config-firefox -type f -exec touch -t 197001010000.00 {} + 2>/dev/null || true
fi

# Skip non-mobile adapted timezone screen in initial-setup
if [ -f /etc/gnome-initial-setup/vendor.conf ]; then
    sed -i 's/skip=.*password.*/skip=account;parental-controls;password;timezone/' /etc/gnome-initial-setup/vendor.conf 2>/dev/null || true
fi

# Enable Bluetooth HAL and bluebinder proxy
systemctl daemon-reload 2>/dev/null || true
systemctl enable android-bluetooth.service bluebinder.service 2>/dev/null || true

# Recompile gsettings schemas
if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true
fi

exit 0
